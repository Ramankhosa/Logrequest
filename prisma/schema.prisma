model Tenant {
  id                             String                          @id @default(cuid())
  name                           String
  code                           String                          @unique
  legalOrganizationName          String
  organizationType               String
  primaryDomains                 String[]
  subscriptionPlan               String
  subscriptionStartDate          DateTime?
  subscriptionEndDate            DateTime?
  entitlementState               TenantEntitlementState          @default(TRIAL_ACTIVE)
  lifecycleState                 TenantLifecycleState            @default(DRAFT)
  ownerUserId                    String?
  createdByUserId                String?
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  memberships                    Membership[]
  invitations                    Invitation[]
  uploadBatches                  UploadBatch[]
  auditLogs                      AuditLog[]
  structureVersions              OrgStructureVersion[]
  orgUnits                       OrgUnit[]
  kraCategories                  KraCategoryDefinition[]
  assessmentPeriods              AssessmentPeriod[]
  kraDefinitions                 KraDefinition[]
  targetAllocations              TargetAllocation[]
  achievements                   Achievement[]
  policy                         TenantPolicy?
  roleDefinitions                OrgRoleDefinition[]
  notifications                  Notification[]
  contributorRewardEvents        ContributorRewardEvent[]
  personnelPolicy                TenantPersonnelPolicy?
  leaveTypeDefinitions           LeaveTypeDefinition[]
  leaveRecords                   LeaveRecord[]
  transferRecords                TransferRecord[]
  resignationRecords             ResignationRecord[]
  personnelActions               PersonnelAction[]
  actingAssignments              ActingAssignment[]
  benefitTypes                   BenefitType[]
  contributorRoles               ContributorRole[]
  externalContribTemplates       ExternalContributorTemplate[]
  permissionAssignments          TenantPermissionAssignment[]
  kpiTemplates                   KpiTemplate[]
  contributorRewards             ContributorReward[]
  journalCatalogRecords          JournalCatalogRecord[]
  journalImportBatches           JournalImportBatch[]
  serviceEntitlements            TenantServiceEntitlement[]
  accreditationBodies            AccreditationBody[]
  assessmentWorkspaces           AssessmentWorkspace[]
  kpiAccreditationBlockLinks KpiAccreditationBlockLink[]
  dataBankDomains                DataBankDomain[]
  dataBankSourceDefinitions      DataBankSourceDefinition[]
  metricSourceLinks              MetricSourceLink[]
  sourceMetricDefinitions        SourceMetricDefinition[]
  blockProjectionRecipes         BlockProjectionRecipe[]

  @@index([lifecycleState, entitlementState])
}

model TenantPolicy {
  id                           String   @id @default(cuid())
  tenantId                     String   @unique
  exactSocialEmailMatchOnly    Boolean  @default(true)
  allowPasswordLogin           Boolean  @default(true)
  allowGoogleLogin             Boolean  @default(true)
  allowMicrosoftLogin          Boolean  @default(true)
  allowGracePeriodAccess       Boolean  @default(true)
  multiTenantMembershipEnabled Boolean  @default(false)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  tenant                       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantServiceEntitlement {
  id               String                         @id @default(cuid())
  tenantId         String
  serviceCode      TenantServiceCode
  status           TenantServiceEntitlementStatus @default(DISABLED)
  enabledAt        DateTime?
  enabledByUserId  String?
  disabledAt       DateTime?
  disabledByUserId String?
  notes            String?
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt
  tenant           Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, serviceCode])
  @@index([tenantId, status])
  @@index([serviceCode, status])
}

model User {
  id                                 String                       @id @default(cuid())
  firstName                          String
  lastName                           String
  officialEmail                      String                       @unique
  alternateEmail                     String?
  phoneNumber                        String?
  allowedLoginMethods                Json?
  passwordHash                       String?
  emailVerifiedAt                    DateTime?
  passwordSetAt                      DateTime?
  passwordChangedAt                  DateTime?
  lastLoginAt                        DateTime?
  lifecycleState                     UserLifecycleState           @default(DRAFT)
  mustResetPassword                  Boolean                      @default(false)
  isSuperadmin                       Boolean                      @default(false)
  failedLoginCount                   Int                          @default(0)
  lockedUntil                        DateTime?
  memberships                        Membership[]
  achievementContributions           AchievementContributor[]     @relation("AchievementContributorUser")
  contributorRewards                 ContributorReward[]          @relation("ContributorRewardUser")
  contributorRewardEvents            ContributorRewardEvent[]
  invitations                        Invitation[]
  socialAccounts                     SocialAccount[]
  passwordResetTokens                PasswordResetToken[]
  orgAssignments                     UserOrgAssignment[]
  orgRoleAssignments                 OrgRoleAssignment[]
  tenantPermissionAssignments        TenantPermissionAssignment[] @relation("TenantPermissionAssignmentUser")
  grantedTenantPermissionAssignments TenantPermissionAssignment[] @relation("TenantPermissionAssignmentCreatedBy")
  managerLines                       ReportingLine[]              @relation("OrgManagerLines")
  memberLines                        ReportingLine[]              @relation("OrgMemberLines")
  targetAllocations                  TargetAllocation[]           @relation("TargetUser")
  notifications                      Notification[]
  workspaceCollaborations            WorkspaceCollaborator[]
  workspaceSectionAssignments        WorkspaceSectionAssignment[]
  workspaceSectionReviewsApproved    WorkspaceSectionReview[]      @relation("WorkspaceSectionReviewApprovedBy")
  workspaceSectionReviewsSubmitted   WorkspaceSectionReview[]      @relation("WorkspaceSectionReviewSubmittedBy")
  workspaceSectionReviewEvents       WorkspaceSectionReviewEvent[]
  workspaceSectionReviewerDecisions  WorkspaceSectionReviewerDecision[]
  workspaceDiscussionThreads         WorkspaceDiscussionThread[]   @relation("WorkspaceDiscussionThreadAuthor")
  workspaceDiscussionMessages        WorkspaceDiscussionMessage[]  @relation("WorkspaceDiscussionMessageAuthor")
  workspaceDiscussionResolutions     WorkspaceDiscussionThread[]   @relation("WorkspaceDiscussionThreadResolvedBy")
  workspaceGuestInvites              WorkspaceGuestInvite[]
  workspaceFreezeLogsFrozen          WorkspaceFreezeLog[]          @relation("WorkspaceFreezeLogFrozenBy")
  workspaceFreezeLogsUnfrozen        WorkspaceFreezeLog[]          @relation("WorkspaceFreezeLogUnfrozenBy")
  keyReviewKpis                      KpiDefinition[]              @relation("KpiKeyReviewer")
  finalReviewKpis                    KpiDefinition[]              @relation("KpiFinalReviewer")
  createdAt                          DateTime                     @default(now())
  updatedAt                          DateTime                     @updatedAt

  @@index([lifecycleState])
}

model SocialAccount {
  id                String       @id @default(cuid())
  userId            String
  provider          AuthProvider
  providerAccountId String
  email             String
  createdAt         DateTime     @default(now())
  lastUsedAt        DateTime?
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

model TenantPermissionAssignment {
  id              String               @id @default(cuid())
  tenantId        String
  userId          String
  roleCode        TenantPermissionRole
  createdByUserId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User                 @relation("TenantPermissionAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  createdByUser   User?                @relation("TenantPermissionAssignmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId, roleCode])
  @@index([tenantId, roleCode])
  @@index([tenantId, userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Membership {
  id                  String              @id @default(cuid())
  tenantId            String
  userId              String
  role                Role
  department          String?
  employeeId          String?
  designation         String?
  dateOfJoining       DateTime?
  personnelStatus     PersonnelStatus     @default(ONBOARDING)
  status              MembershipStatus    @default(INVITED)
  invitationState     InvitationStatus    @default(PENDING)
  invitedAt           DateTime?
  activationTimestamp DateTime?
  lastAccessTimestamp DateTime?
  createdByUserId     String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitations         Invitation[]
  uploadRows          UploadRow[]
  leaveRecords        LeaveRecord[]
  transfers           TransferRecord[]    @relation("TransferSourceMember")
  resignations        ResignationRecord[]
  personnelActions    PersonnelAction[]
  actingFor           ActingAssignment[]  @relation("ActingUser")
  coveredBy           ActingAssignment[]  @relation("OriginalUser")

  @@unique([tenantId, userId])
  @@unique([tenantId, employeeId])
  @@index([tenantId, role, status])
  @@index([tenantId, personnelStatus])
}

model Invitation {
  id              String           @id @default(cuid())
  token           String           @unique
  tenantId        String
  userId          String
  membershipId    String?
  status          InvitationStatus @default(PENDING)
  deliveryChannel String           @default("email")
  invitedByUserId String?
  expiresAt       DateTime
  sentAt          DateTime         @default(now())
  acceptedAt      DateTime?
  revokedAt       DateTime?
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership      Membership?      @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, expiresAt])
}

model UploadBatch {
  id                 String            @id @default(cuid())
  tenantId           String
  uploadedByUserId   String?
  fileName           String
  fileType           String
  uploadType         String            @default("MEMBERS")
  structureVersionId String?
  status             UploadBatchStatus @default(UPLOADED)
  totalRows          Int               @default(0)
  validRows          Int               @default(0)
  warningRows        Int               @default(0)
  rejectedRows       Int               @default(0)
  provisionedRows    Int               @default(0)
  metadata           Json?
  confirmedAt        DateTime?
  provisionedAt      DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rows               UploadRow[]

  @@index([tenantId, status, createdAt])
}

model UploadRow {
  id             String          @id @default(cuid())
  uploadBatchId  String
  membershipId   String?
  rowIndex       Int
  status         UploadRowStatus
  rawData        Json
  normalizedData Json?
  errors         Json?
  warnings       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  uploadBatch    UploadBatch     @relation(fields: [uploadBatchId], references: [id], onDelete: Cascade)
  membership     Membership?     @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@unique([uploadBatchId, rowIndex])
  @@index([uploadBatchId, status])
}

model JournalCatalogRecord {
  id                       String                    @id @default(cuid())
  tenantId                 String?
  scope                    JournalCatalogScope
  scopeTenantKey           String
  sourceSystem             JournalImportSourceSystem
  sourceYear               Int
  sourceId                 String?
  identityKey              String
  currentIdentityKey       String?
  title                    String
  normalizedTitle          String
  type                     String
  issnRaw                  String?
  issnPrimary              String?
  issnList                 String[]
  issnNormalizedList       String[]
  publisher                String?
  duplicatePublisher       String?
  openAccessLabel          String?
  isOpenAccess             Boolean?
  openAccessDiamondLabel   String?
  isOpenAccessDiamond      Boolean?
  sjr                      Float?
  sjrBestQuartile          String?
  hIndex                   Int?
  totalDocsCurrent         Int?
  totalDocs3Years          Int?
  totalRefs                Int?
  totalCitations3Years     Int?
  citableDocs3Years        Int?
  citationsPerDoc2Years    Float?
  refsPerDoc               Float?
  femalePercent            Float?
  overton                  Int?
  sdg                      Int?
  country                  String?
  region                   String?
  coverage                 String?
  categories               String?
  areas                    String?
  policyStatus             JournalPolicyStatus       @default(ALLOWED)
  policyNote               String?
  isJournalEligible        Boolean                   @default(false)
  importBatchId            String?
  overriddenGlobalRecordId String?
  rawSourcePayload         Json?
  metadata                 Json?
  isArchived               Boolean                   @default(false)
  archivedAt               DateTime?
  archivedByUserId         String?
  archiveReason            String?
  isSuperseded             Boolean                   @default(false)
