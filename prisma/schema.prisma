generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

enum TenantLifecycleState {
  DRAFT
  PENDING_VERIFICATION
  ACTIVE
  GRACE_PERIOD
  SUSPENDED
  REVOKED
  ARCHIVED
}

enum TenantEntitlementState {
  TRIAL_ACTIVE
  PAID_ACTIVE
  GRACE_PERIOD
  PAYMENT_HOLD
  SUSPENDED
  REVOKED
  EXPIRED
  ARCHIVED
}

enum UserLifecycleState {
  DRAFT
  INVITED
  PENDING_ACTIVATION
  ACTIVE
  LOCKED
  SUSPENDED
  REVOKED
  ARCHIVED
}

enum MembershipStatus {
  INVITED
  PENDING_ACTIVATION
  ACTIVE
  LOCKED
  SUSPENDED
  REVOKED
  ARCHIVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum Role {
  SUPERADMIN
  TENANT_OWNER
  TENANT_ADMIN
  TENANT_USER
}

enum ContributorType {
  INTERNAL
  EXTERNAL
}

enum ExternalContributorScope {
  NATIONAL
  INTERNATIONAL
}

enum AuthProvider {
  GOOGLE
  MICROSOFT
}

enum UploadBatchStatus {
  UPLOADED
  VALIDATED
  CONFIRMED
  PROVISIONED
  PARTIALLY_PROVISIONED
  FAILED
}

enum UploadRowStatus {
  VALID
  WARNING
  REJECTED
  PROVISIONED
}

enum JournalCatalogScope {
  GLOBAL
  TENANT
}

enum JournalImportSourceSystem {
  SCIMAGO_RAW
  TENANT_TEMPLATE
}

enum JournalImportBatchStatus {
  VALIDATED
  APPLYING
  CONFIRMED
  FAILED
}

enum JournalImportRowStatus {
  VALID
  WARNING
  REJECTED
  APPLIED
}

enum JournalPolicyStatus {
  ALLOWED
  DISABLED
  BLACKLISTED
}

enum OrgStructureState {
  DRAFT
  VALIDATED
  PUBLISHED
  SUPERSEDED
  ARCHIVED
}

enum OrgUnitCategory {
  ORG_ROOT
  CAMPUS
  SCHOOL_LIKE_UNIT
  DEPARTMENT_LIKE_UNIT
  CENTER
  LAB
  OFFICE
  DIVISION
  PROGRAM
  ADMINISTRATIVE_UNIT
  BUSINESS_UNIT
  FUNCTION
  TEAM
  REGION
  BRANCH
  SITE
  PROJECT_UNIT
  CUSTOM_UNIT
}

enum OrgUnitState {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrgAssignmentType {
  PRIMARY
  SECONDARY
}

enum OrgRoleScope {
  NODE
  DESCENDANTS
}

// ── KRA/KPI Enums (Release 1) ──────────────────────────────────────────────

enum KpiMeasurementType {
  NUMERIC          // count of items (publications, patents)
  PERCENTAGE       // pass rate, attendance
  CURRENCY         // grant amount, revenue
  BOOLEAN          // yes/no (accreditation obtained)
  RATING           // 1-5 scale
  MILESTONE        // NOT_STARTED → IN_PROGRESS → COMPLETED
  DATE_TARGET      // deadline compliance
  GRADE            // qualitative scale (Outstanding...Poor)
}

enum KraCategoryScope {
  GLOBAL           // superadmin-managed, visible to all tenants
  TENANT           // tenant-created
}

enum AssessmentPeriodState {
  DRAFT
  OPEN             // targets can be set
  IN_PROGRESS      // targets locked, achievements recorded
  UNDER_REVIEW     // verification happening
  CLOSED           // finalized, read-only
  ARCHIVED
}

enum AssessmentPeriodType {
  CALENDAR_YEAR    // Jan-Dec
  FINANCIAL_YEAR   // Apr-Mar (configurable)
  SPECIFIC_RANGE   // custom start/end
}

enum ReviewCycleFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
}

enum KraDefinitionState {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum KpiDefinitionState {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum KpiAllocationType {
  DEPARTMENT       // stays at dept level, head owns it
  INDIVIDUAL       // must be split to individual members
  BOTH             // head decides whether to keep or split
}

enum TargetAllocationState {
  ACTIVE           // final value entered, target is live
  LOCKED           // frozen after deadline, no changes
}

enum AchievementState {
  DRAFT            // being filled in
  SUBMITTED        // submitted for verification
  RECOMMENDED      // dept head has endorsed
  VERIFIED         // approved
  REJECTED         // sent back with reason (displayed as "Not Approved" in UI)
}

enum AchievementFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  URL
  EMAIL
  SELECT
  MULTI_SELECT
  BOOLEAN
  DECLARATION
  FILE_LINK
}

enum ScoringMethod {
  LINEAR           // actual/target * 100
  THRESHOLD        // below = 0, above = 100
  SLAB             // defined ranges
}

enum ScoringDirection {
  ASCENDING        // higher actual = better (publications, revenue)
  DESCENDING       // lower actual = better (attrition, defects, costs)
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum GradeValue {
  OUTSTANDING
  VERY_GOOD
  GOOD
  SATISFACTORY
  NEEDS_IMPROVEMENT
  POOR
}

// ── KRA/KPI Enums (Release 2) ──────────────────────────────────────────────

enum KpiFlowStatus {
  CREATED           // allocation just created, no work started
  ASSIGNED          // target communicated to assignee
  IN_PROGRESS       // assignee working on it
  SUBMITTED         // assignee submitted achievement for review
  KEY_REVIEW        // key department reviewing (optional step)
  KEY_APPROVED      // key department endorsed
  KEY_REJECTED      // key department sent back (auto-resets to IN_PROGRESS)
  FINAL_REVIEW      // final/starting department reviewing (optional step)
  VERIFIED          // fully approved
  REJECTED          // sent back at any review level
}

enum EvidenceType {
  DOCUMENT          // PDF, DOC, DOCX
  URL               // web link
  CERTIFICATE       // scanned certificate
  SELF_DECLARATION  // self-attested
  SYSTEM_GENERATED  // auto-captured by system
  NONE              // no evidence needed
}

enum TeamCreditMethod {
  FULL_EACH          // each contributor gets 100% credit (count-based KPIs)
  EQUAL_SPLIT        // credit divided equally among all contributors
  WEIGHTED_SPLIT     // credit split per contributor weight (e.g., first author 60%)
  PRIMARY_ONLY       // only primary contributor gets credit
}

enum KpiParticipantMode {
  SINGLE_OWNER
  OPTIONAL_TEAM
  REQUIRED_TEAM
}

enum KpiRewardRecurrencePolicy {
  RECURRING
  ONCE_PER_PERIOD
  ONCE_PER_KPI_LIFETIME
  ONCE_PER_UNIQUE_KEY
}

enum KpiRewardTierMatchMode {
  HIGHEST_MATCH
  MANUAL_SELECT
}

enum KpiRewardTrigger {
  FINAL_VERIFY
  MANUAL
  STAGE_COMPLETE
}

enum KpiRewardAmountMode {
  FIXED_VALUE
  FIXED_POOL
  FIXED_PER_PERSON
  PERCENT_OF_FIELD
  PER_UNIT
  PERCENT_OF_SCORE
}

enum KpiRewardDistributionMode {
  DIRECT_OWNER
  ROLE_PERCENT_SPLIT
  FIXED_PER_PERSON
  EQUAL_SPLIT
  CREDIT_PERCENT_SPLIT
  LEAD_ONLY
}

enum KpiRewardSingleEligibleHandling {
  FULL_TO_SINGLE
  KEEP_CONFIGURED_SPLIT
  ERROR
}

enum KpiRewardEmptyShareHandling {
  ROLLOVER_TO_MATCHED
  DROP_UNALLOCATED
  ERROR
}

enum ContributorRewardState {
  DRAFT
  PENDING
  RELEASED
  REVOKED
}

enum PersonnelStatus {
  ONBOARDING
  ACTIVE
  ON_LEAVE
  NOTICE_PERIOD
  SEPARATED
  SUSPENDED_HR
}

enum PersonnelActionType {
  ONBOARD
  ACTIVATE
  ASSIGN_UNIT
  REMOVE_UNIT
  CHANGE_PRIMARY_UNIT
  ASSIGN_ROLE
  REMOVE_ROLE
  LEAVE_START
  LEAVE_END
  LEAVE_EXTEND
  TRANSFER_INITIATE
  TRANSFER_COMPLETE
  TRANSFER_CANCEL
  RESIGN
  RESIGN_WITHDRAW
  TERMINATE
  REINSTATE
  RETIRE
}

enum LeaveStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
  EXTENDED
}

enum TransferStatus {
  PROPOSED
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

enum TransferKpiPolicy {
  CARRY_ALL
  LEAVE_ALL
  SELECTIVE
}

enum TransferTargetActionType {
  CARRIED
  LEFT_BEHIND
  LOCKED_SOURCE_ONLY
  REASSIGNED_AFTER_TRANSFER
}

enum TransferStatusEventType {
  INITIATED
  APPROVED
  REJECTED
  CANCELLED
  EXECUTED
  CONFIGURED
}

enum ResignationStatus {
  SUBMITTED
  NOTICE_PERIOD
  HANDOVER_PENDING
  COMPLETED
  WITHDRAWN
}

model Tenant {
  id                    String                 @id @default(cuid())
  name                  String
  code                  String                 @unique
  legalOrganizationName String
  organizationType      String
  primaryDomains        String[]
  subscriptionPlan      String
  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?
  entitlementState      TenantEntitlementState @default(TRIAL_ACTIVE)
  lifecycleState        TenantLifecycleState   @default(DRAFT)
  ownerUserId           String?
  createdByUserId       String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  memberships           Membership[]
  invitations           Invitation[]
  uploadBatches         UploadBatch[]
  auditLogs             AuditLog[]
  structureVersions     OrgStructureVersion[]
  orgUnits              OrgUnit[]
  kraCategories         KraCategoryDefinition[]
  assessmentPeriods     AssessmentPeriod[]
  kraDefinitions        KraDefinition[]
  targetAllocations     TargetAllocation[]
  achievements          Achievement[]
  policy                TenantPolicy?
  roleDefinitions       OrgRoleDefinition[]
  notifications         Notification[]
  contributorRewardEvents ContributorRewardEvent[]
  personnelPolicy       TenantPersonnelPolicy?
  leaveTypeDefinitions  LeaveTypeDefinition[]
  leaveRecords          LeaveRecord[]
  transferRecords       TransferRecord[]
  resignationRecords    ResignationRecord[]
  personnelActions      PersonnelAction[]
  actingAssignments     ActingAssignment[]
  benefitTypes          BenefitType[]
  contributorRoles      ContributorRole[]
  externalContribTemplates ExternalContributorTemplate[]
  kpiTemplates          KpiTemplate[]
  contributorRewards    ContributorReward[]
  journalCatalogRecords JournalCatalogRecord[]
  journalImportBatches  JournalImportBatch[]

  @@index([lifecycleState, entitlementState])
}

model TenantPolicy {
  id                           String   @id @default(cuid())
  tenantId                     String   @unique
  exactSocialEmailMatchOnly    Boolean  @default(true)
  allowPasswordLogin           Boolean  @default(true)
  allowGoogleLogin             Boolean  @default(true)
  allowMicrosoftLogin          Boolean  @default(true)
  allowGracePeriodAccess       Boolean  @default(true)
  multiTenantMembershipEnabled Boolean  @default(false)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  tenant                       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id                  String               @id @default(cuid())
  firstName           String
  lastName            String
  officialEmail       String               @unique
  alternateEmail      String?
  phoneNumber         String?
  allowedLoginMethods Json?
  passwordHash        String?
  emailVerifiedAt     DateTime?
  passwordSetAt       DateTime?
  passwordChangedAt   DateTime?
  lastLoginAt         DateTime?
  lifecycleState      UserLifecycleState   @default(DRAFT)
  mustResetPassword   Boolean              @default(false)
  isSuperadmin        Boolean              @default(false)
  failedLoginCount    Int                  @default(0)
  lockedUntil         DateTime?
  memberships         Membership[]
  achievementContributions AchievementContributor[] @relation("AchievementContributorUser")
  contributorRewards  ContributorReward[]  @relation("ContributorRewardUser")
  contributorRewardEvents ContributorRewardEvent[]
  invitations         Invitation[]
  socialAccounts      SocialAccount[]
  passwordResetTokens PasswordResetToken[]
  orgAssignments      UserOrgAssignment[]
  orgRoleAssignments  OrgRoleAssignment[]
  managerLines        ReportingLine[]      @relation("OrgManagerLines")
  memberLines         ReportingLine[]      @relation("OrgMemberLines")
  targetAllocations   TargetAllocation[]   @relation("TargetUser")
  notifications       Notification[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([lifecycleState])
}

model SocialAccount {
  id                String       @id @default(cuid())
  userId            String
  provider          AuthProvider
  providerAccountId String
  email             String
  createdAt         DateTime     @default(now())
  lastUsedAt        DateTime?
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Membership {
  id                  String              @id @default(cuid())
  tenantId            String
  userId              String
  role                Role
  department          String?
  employeeId          String?
  designation         String?
  dateOfJoining       DateTime?
  personnelStatus     PersonnelStatus     @default(ONBOARDING)
  status              MembershipStatus    @default(INVITED)
  invitationState     InvitationStatus    @default(PENDING)
  invitedAt           DateTime?
  activationTimestamp DateTime?
  lastAccessTimestamp DateTime?
  createdByUserId     String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitations         Invitation[]
  uploadRows          UploadRow[]
  leaveRecords        LeaveRecord[]
  transfers           TransferRecord[]    @relation("TransferSourceMember")
  resignations        ResignationRecord[]
  personnelActions    PersonnelAction[]
  actingFor           ActingAssignment[]  @relation("ActingUser")
  coveredBy           ActingAssignment[]  @relation("OriginalUser")

  @@unique([tenantId, userId])
  @@unique([tenantId, employeeId])
  @@index([tenantId, role, status])
  @@index([tenantId, personnelStatus])
}

model Invitation {
  id              String           @id @default(cuid())
  token           String           @unique
  tenantId        String
  userId          String
  membershipId    String?
  status          InvitationStatus @default(PENDING)
  deliveryChannel String           @default("email")
  invitedByUserId String?
  expiresAt       DateTime
  sentAt          DateTime         @default(now())
  acceptedAt      DateTime?
  revokedAt       DateTime?
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership      Membership?      @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, expiresAt])
}

model UploadBatch {
  id                 String            @id @default(cuid())
  tenantId           String
  uploadedByUserId   String?
  fileName           String
  fileType           String
  uploadType         String            @default("MEMBERS")
  structureVersionId String?
  status             UploadBatchStatus @default(UPLOADED)
  totalRows          Int               @default(0)
  validRows          Int               @default(0)
  warningRows        Int               @default(0)
  rejectedRows       Int               @default(0)
  provisionedRows    Int               @default(0)
  metadata           Json?
  confirmedAt        DateTime?
  provisionedAt      DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rows               UploadRow[]

  @@index([tenantId, status, createdAt])
}

model UploadRow {
  id             String          @id @default(cuid())
  uploadBatchId  String
  membershipId   String?
  rowIndex       Int
  status         UploadRowStatus
  rawData        Json
  normalizedData Json?
  errors         Json?
  warnings       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  uploadBatch    UploadBatch     @relation(fields: [uploadBatchId], references: [id], onDelete: Cascade)
  membership     Membership?     @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@unique([uploadBatchId, rowIndex])
  @@index([uploadBatchId, status])
}

model JournalCatalogRecord {
  id                    String                  @id @default(cuid())
  tenantId              String?
  scope                 JournalCatalogScope
  scopeTenantKey        String
  sourceSystem          JournalImportSourceSystem
  sourceYear            Int
  sourceId              String?
  identityKey           String
  currentIdentityKey    String?
  title                 String
  normalizedTitle       String
  type                  String
  issnRaw               String?
  issnPrimary           String?
  issnList              String[]
  issnNormalizedList    String[]
  publisher             String?
  duplicatePublisher    String?
  openAccessLabel       String?
  isOpenAccess          Boolean?
  openAccessDiamondLabel String?
  isOpenAccessDiamond   Boolean?
  sjr                   Float?
  sjrBestQuartile       String?
  hIndex                Int?
  totalDocsCurrent      Int?
  totalDocs3Years       Int?
  totalRefs             Int?
  totalCitations3Years  Int?
  citableDocs3Years     Int?
  citationsPerDoc2Years Float?
  refsPerDoc            Float?
  femalePercent         Float?
  overton               Int?
  sdg                   Int?
  country               String?
  region                String?
  coverage              String?
  categories            String?
  areas                 String?
  policyStatus          JournalPolicyStatus     @default(ALLOWED)
  policyNote            String?
  isJournalEligible     Boolean                 @default(false)
  importBatchId         String?
  overriddenGlobalRecordId String?
  rawSourcePayload      Json?
  metadata              Json?
  isArchived            Boolean                 @default(false)
  archivedAt            DateTime?
  archivedByUserId      String?
  archiveReason         String?
  isSuperseded          Boolean                 @default(false)
  supersededAt          DateTime?
  supersededByBatchId   String?
  createdByUserId       String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  tenant                Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  importBatch           JournalImportBatch?     @relation("JournalBatchRecords", fields: [importBatchId], references: [id], onDelete: SetNull)
  overrideSource        JournalCatalogRecord?   @relation("JournalOverrideSource", fields: [overriddenGlobalRecordId], references: [id], onDelete: SetNull)
  tenantOverrides       JournalCatalogRecord[]  @relation("JournalOverrideSource")
  supersededByBatch     JournalImportBatch?     @relation("JournalSupersededBatch", fields: [supersededByBatchId], references: [id], onDelete: SetNull)

  @@index([tenantId, sourceYear, isArchived])
  @@index([scopeTenantKey, sourceYear, type])
  @@index([scopeTenantKey, sourceYear, sjrBestQuartile])
  @@index([scopeTenantKey, sourceYear, issnPrimary])
  @@index([scopeTenantKey, sourceYear, policyStatus])
  @@index([scopeTenantKey, sourceYear, currentIdentityKey])
  @@unique([scopeTenantKey, sourceYear, currentIdentityKey])
}

model JournalImportBatch {
  id               String                   @id @default(cuid())
  tenantId         String?
  scope            JournalCatalogScope
  scopeTenantKey   String
  uploadedByUserId String?
  fileName         String
  fileType         String
  sourceSystem     JournalImportSourceSystem
  sourceYear       Int
  mode             String
  status           JournalImportBatchStatus @default(VALIDATED)
  totalRows        Int                      @default(0)
  validRows        Int                      @default(0)
  warningRows      Int                      @default(0)
  rejectedRows     Int                      @default(0)
  appliedRows      Int                      @default(0)
  metadata         Json?
  confirmedAt      DateTime?
  failedAt         DateTime?
  failureMessage   String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  tenant           Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rows             JournalImportRow[]
  importedRecords  JournalCatalogRecord[]   @relation("JournalBatchRecords")
  supersededRecords JournalCatalogRecord[]  @relation("JournalSupersededBatch")

  @@index([tenantId, scope, sourceYear, createdAt])
  @@index([scopeTenantKey, sourceYear, status])
}

model JournalImportRow {
  id             String                 @id @default(cuid())
  importBatchId  String
  rowIndex       Int
  status         JournalImportRowStatus
  sourceId       String?
  identityKey    String?
  rawText        String?
  rawData        Json
  normalizedData Json?
  errors         Json?
  warnings       Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  importBatch    JournalImportBatch     @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([importBatchId, rowIndex])
  @@index([importBatchId, status])
}

model AuditLog {
  id            String   @id @default(cuid())
  tenantId      String?
  actorUserId   String?
  actorRole     Role?
  targetType    String
  targetId      String
  action        String
  reason        String?
  sourceIp      String?
  userAgent     String?
  previousState Json?
  newState      Json?
  metadata      Json?
  createdAt     DateTime @default(now())
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([targetType, targetId])
}

model OrgStructureVersion {
  id                String              @id @default(cuid())
  tenantId          String
  name              String
  versionNumber     Int
  state             OrgStructureState   @default(DRAFT)
  notes             String?
  validationSummary Json?
  validatedAt       DateTime?
  publishedAt       DateTime?
  createdByUserId   String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitTypes         OrgUnitType[]
  units             OrgUnit[]
  reportingLines    ReportingLine[]
  userAssignments   UserOrgAssignment[]
  roleAssignments   OrgRoleAssignment[]
  actingAssignments ActingAssignment[]

  @@unique([tenantId, versionNumber])
  @@index([tenantId, state])
}

model OrgUnitType {
  id               String              @id @default(cuid())
  versionId        String
  typeKey          String
  internalCategory OrgUnitCategory
  displayLabel     String
  description      String?
  allowRoot        Boolean             @default(false)
  sortOrder        Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  version          OrgStructureVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  units            OrgUnit[]

  @@unique([versionId, typeKey])
  @@index([versionId, sortOrder])
}

model OrgUnit {
  id                String              @id @default(cuid())
  tenantId          String
  versionId         String
  typeId            String
  code              String
  name              String
  parentId          String?
  level             Int                 @default(0)
  sortOrder         Int                 @default(0)
  path              String?
  state             OrgUnitState        @default(DRAFT)
  metadata          Json?
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  createdByUserId   String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version           OrgStructureVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  type              OrgUnitType         @relation(fields: [typeId], references: [id], onDelete: Restrict)
  parent            OrgUnit?            @relation("OrgUnitTree", fields: [parentId], references: [id], onDelete: SetNull)
  children          OrgUnit[]           @relation("OrgUnitTree")
  reportingLines    ReportingLine[]
  userAssignments   UserOrgAssignment[]
  roleAssignments   OrgRoleAssignment[]
  kpiStarting       KpiDefinition[]     @relation("KpiStartingUnit")
  kpiKeyUnit        KpiDefinition[]     @relation("KpiKeyUnit")
  kpiFinalUnit      KpiDefinition[]     @relation("KpiFinalUnit")
  kpiTargetUnits    KpiTargetUnit[]     @relation("KpiTargetUnits")
  targetAllocations TargetAllocation[]  @relation("TargetUnit")
  actingAssignments ActingAssignment[]
  transfersFrom     TransferRecord[]    @relation("TransferSource")
  transfersTo       TransferRecord[]    @relation("TransferTarget")

  @@unique([versionId, code])
  @@index([tenantId, code])
  @@index([versionId, parentId])
}

model ReportingLine {
  id            String              @id @default(cuid())
  versionId     String
  unitId        String?
  managerUserId String
  memberUserId  String
  lineType      String              @default("SOLID")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  version       OrgStructureVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  unit          OrgUnit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  manager       User                @relation("OrgManagerLines", fields: [managerUserId], references: [id], onDelete: Cascade)
  member        User                @relation("OrgMemberLines", fields: [memberUserId], references: [id], onDelete: Cascade)

  @@index([versionId, unitId])
  @@index([managerUserId, memberUserId])
}

model UserOrgAssignment {
  id             String              @id @default(cuid())
  versionId      String
  unitId         String
  userId         String
  assignmentType OrgAssignmentType   @default(PRIMARY)
  isPrimary      Boolean             @default(true)
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  version        OrgStructureVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  unit           OrgUnit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([versionId, unitId, userId, assignmentType])
  @@index([versionId, userId])
}

model OrgRoleAssignment {
  id               String              @id @default(cuid())
  versionId        String
  unitId           String
  userId           String
  roleDefinitionId String?
  roleName         String
  scope            OrgRoleScope        @default(NODE)
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  version          OrgStructureVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  unit             OrgUnit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleDefinition   OrgRoleDefinition?  @relation(fields: [roleDefinitionId], references: [id], onDelete: SetNull)

  @@unique([versionId, unitId, userId, roleName])
  @@index([versionId, unitId, roleName])
  @@index([versionId, userId])
  @@index([roleDefinitionId])
}

model OrgRoleDefinition {
  id                String              @id @default(cuid())
  tenantId          String
  roleKey           String
  displayLabel      String
  description       String?
  isUnitHead        Boolean             @default(false)
  approvalAuthority Boolean             @default(false)
  maxPerUnit        Int                 @default(-1)
  sortOrder         Int                 @default(0)
  isActive          Boolean             @default(true)
  createdByUserId   String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleAssignments   OrgRoleAssignment[]

  @@unique([tenantId, roleKey])
  @@index([tenantId, isActive])
}

// ── Module 2: KRA/KPI Framework (Release 1) ────────────────────────────────

model KraCategoryDefinition {
  id              String           @id @default(cuid())
  tenantId        String?          // null = global (superadmin)
  scope           KraCategoryScope @default(TENANT)
  categoryKey     String           // "RESEARCH", "FINANCIAL"
  displayLabel    String
  description     String?
  iconName        String?          // lucide icon name for UI
  colorHex        String?          // dashboard color
  sortOrder       Int              @default(0)
  isActive        Boolean          @default(true)
  createdByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kraDefinitions  KraDefinition[]

  @@unique([tenantId, categoryKey])
  @@index([scope, isActive])
}

model AssessmentPeriod {
  id                    String                @id @default(cuid())
  tenantId              String
  name                  String                // "AY 2025-26"
  code                  String                // "AY2025-26"
  periodType            AssessmentPeriodType  @default(SPECIFIC_RANGE)
  startDate             DateTime
  endDate               DateTime
  state                 AssessmentPeriodState @default(DRAFT)
  reviewFrequency       ReviewCycleFrequency  @default(ANNUAL)
  targetSettingDeadline DateTime?
  achievementDeadline   DateTime?
  reviewDeadline        DateTime?
  description           String?
  createdByUserId       String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kraDefinitions        KraDefinition[]
  targetAllocations     TargetAllocation[]
  reviewCycles          ReviewCycle[]

  @@unique([tenantId, code])
  @@index([tenantId, state])
}

model KraDefinition {
  id              String              @id @default(cuid())
  tenantId        String
  periodId        String
  categoryId      String?
  title           String
  description     String?
  weightage       Int                 @default(0) // integer, out of org total 100
  state           KraDefinitionState  @default(DRAFT)
  sortOrder       Int                 @default(0)
  createdByUserId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period          AssessmentPeriod    @relation(fields: [periodId], references: [id], onDelete: Restrict)
  category        KraCategoryDefinition? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  kpiDefinitions  KpiDefinition[]

  @@index([tenantId, periodId])
  @@index([tenantId, state])
}

model KpiDefinition {
  id                String             @id @default(cuid())
  kraDefinitionId   String
  title             String
  description       String?
  // ── Measurement ──
  measurementType   KpiMeasurementType @default(NUMERIC)
  unitLabel         String?            // "count", "%", "INR", "days"
  weightage         Int                @default(0) // must sum to parent KRA's weightage
  defaultTarget     Float?
  measurementConfig Json?              // Zod-validated per type
  // ── Scoring ──
  scoringMethod     ScoringMethod      @default(LINEAR)
  scoringDirection  ScoringDirection   @default(ASCENDING)
  scoringConfig     Json?              // Zod-validated per method
  isPerCapita       Boolean            @default(false)
  // ── Allocation ──
  allocationType    KpiAllocationType  @default(BOTH)
  startingUnitId    String             // originating department
  // ── Achievement Template ──
  achievementTemplateKey  String?    // "PUBLICATION", "PATENT", etc.
  achievementFormConfig   Json?      // [{key, label, type, required, options?, pattern?}]
  // ── R2: Verification Routing ──
  keyUnitId             String?
  finalUnitId           String?
  // ── R2: SOP & Evidence ──
  sopDescription        String?
  sopFiles              Json?
  evidenceRequired      Boolean            @default(true)
  evidenceTypes         EvidenceType[]
  evidenceInstructions  String?
  // ── R2: Team KPI ──
  isTeamKpi             Boolean            @default(false)
  teamCreditMethod      TeamCreditMethod   @default(FULL_EACH)
  // ── R2.2: Stages & submission ──
  allowPartialCompletion Boolean           @default(true)
  allowMultipleAchievementsPerAllocation Boolean @default(false)
  contributionRoles      Json?
  participantMode        KpiParticipantMode        @default(SINGLE_OWNER)
  rewardRecurrencePolicy KpiRewardRecurrencePolicy @default(RECURRING)
  policyDateFieldKey     String?
  // ── State ──
  state             KpiDefinitionState @default(DRAFT)
  sortOrder         Int                @default(0)
  guidanceNotes     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  kraDefinition     KraDefinition      @relation(fields: [kraDefinitionId], references: [id], onDelete: Cascade)
  startingUnit      OrgUnit            @relation("KpiStartingUnit", fields: [startingUnitId], references: [id], onDelete: Restrict)
  keyUnit           OrgUnit?           @relation("KpiKeyUnit", fields: [keyUnitId], references: [id], onDelete: SetNull)
  finalUnit         OrgUnit?           @relation("KpiFinalUnit", fields: [finalUnitId], references: [id], onDelete: SetNull)
  targetAllocations TargetAllocation[]
  achievements      Achievement[]
  targetUnits       KpiTargetUnit[]
  stages            KpiStageDefinition[]
  applicableRoles   KpiApplicableRole[]
  contributorConfig KpiContributorConfig?
  rewardTiers       KpiRewardTier[]
  rewardComponents  KpiRewardComponent[]
  contributorRewards ContributorReward[]

  @@index([kraDefinitionId])
  @@index([startingUnitId])
  @@index([keyUnitId])
  @@index([finalUnitId])
}

model BenefitType {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  description String?
  unit        String
  precision   Int      @default(2)
  roundingMode String  @default("HALF_UP")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rewardComponents KpiRewardComponent[]
  contributorRewards ContributorReward[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model ContributorRole {
  id                   String              @id @default(cuid())
  tenantId             String
  code                 String
  name                 String
  description          String?
  defaultCreditPercent Float
  isActive             Boolean             @default(true)
  sortOrder            Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicableKpis       KpiApplicableRole[]
  achievementContributors AchievementContributor[]
  rewardDistributions  KpiRewardDistribution[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model KpiApplicableRole {
  id                String          @id @default(cuid())
  kpiDefinitionId   String
  contributorRoleId String
  isDefault         Boolean         @default(false)
  sortOrder         Int             @default(0)
  kpiDefinition     KpiDefinition   @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)
  contributorRole   ContributorRole @relation(fields: [contributorRoleId], references: [id], onDelete: Cascade)

  @@unique([kpiDefinitionId, contributorRoleId])
  @@index([kpiDefinitionId])
}

model ExternalContributorTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  fields      Json
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kpiConfigs  KpiContributorConfig[]

  @@index([tenantId, isActive])
}

model KpiContributorConfig {
  id                        String                      @id @default(cuid())
  kpiDefinitionId           String                      @unique
  externalContribTemplateId String?
  allowExternalContributors Boolean                     @default(true)
  duplicateCheckFields      Json?
  creditSumMode             String                      @default("MUST_EQUAL_100")
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  kpiDefinition             KpiDefinition               @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)
  externalContribTemplate   ExternalContributorTemplate? @relation(fields: [externalContribTemplateId], references: [id])

  @@index([externalContribTemplateId])
}

model KpiTemplate {
  id            String   @id @default(cuid())
  tenantId      String?
  code          String   @unique
  name          String
  description   String?
  category      String?
  isSystem      Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  builderPayload Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@index([isSystem, isActive])
}

model TargetAllocation {
  id                 String                @id @default(cuid())
  tenantId           String
  periodId           String
  kpiDefinitionId    String
  assignedToUnitId   String?
  assignedToUserId   String?
  allocatedByUserId  String
  // Target (polymorphic by measurement type)
  targetValue        Float?
  targetDate         DateTime?
  targetMilestone    MilestoneStatus?
  targetGrade        GradeValue?
  targetBoolean      Boolean?
  targetRating       Int?
  // State
  state              TargetAllocationState @default(ACTIVE)
  lockedAt           DateTime?
  // ── R2: Flow tracking ──
  flowStatus             KpiFlowStatus     @default(CREATED)
  flowLog                Json?
  // ── R2: Verifier override ──
  verifierOverrideUserId String?
  verifierOverrideNote   String?
  // ── R2: Team weights ──
  teamWeights            Json?
  // Cascade lineage
  parentAllocationId String?
  notes              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period             AssessmentPeriod      @relation(fields: [periodId], references: [id], onDelete: Restrict)
  kpiDefinition      KpiDefinition         @relation(fields: [kpiDefinitionId], references: [id], onDelete: Restrict)
  assignedToUnit     OrgUnit?              @relation("TargetUnit", fields: [assignedToUnitId], references: [id], onDelete: SetNull)
  assignedToUser     User?                 @relation("TargetUser", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  parentAllocation   TargetAllocation?     @relation("CascadeParent", fields: [parentAllocationId], references: [id], onDelete: SetNull)
  childAllocations   TargetAllocation[]    @relation("CascadeParent")
  achievements       Achievement[]
  stageProgress      KpiStageProgress[]
  transferActions    TransferTargetAction[]

  @@index([tenantId, periodId, kpiDefinitionId])
  @@index([assignedToUnitId, periodId])
  @@index([assignedToUserId, periodId])
  @@index([parentAllocationId])
}

model Achievement {
  id                    String             @id @default(cuid())
  tenantId              String
  periodId              String
  kpiDefinitionId       String
  targetAllocationId    String?
  reportedByUserId      String
  oboReportedForUserId  String?
  // Actuals (polymorphic)
  actualValue           Float?
  actualDate            DateTime?
  actualMilestone       MilestoneStatus?
  actualGrade           GradeValue?
  actualBoolean         Boolean?
  actualRating          Int?
  // Evidence (simple text in R1, file uploads added in R2)
  evidenceDescription   String?
  evidenceLinks         String[]           // URLs for now, file uploads in R2
  // ── R2: Evidence files ──
  evidenceFiles          Json?
  // ── R2: Multi-level verification ──
  currentVerifierUserId  String?
  currentVerifierUnitId  String?
  // ── R2: Team achievement ──
  isTeamAchievement      Boolean           @default(false)
  // Scoring
  computedScore         Float?             // 0-100
  // Dynamic form data (R1.1a)
  achievementFormData       Json?      // filled-in custom fields per KPI template
  // ── R2.2: Named instance & stage score ──
  title                 String?
  contributionRole      String?
  creditPercent         Float?
  effectiveScore        Float?
  stageCompletionScore  Float?
  duplicateCheckResult  Json?
  isOBO                 Boolean            @default(false)
  // 2-level verification (R1.1a)
  state                 AchievementState   @default(DRAFT)
  recommendedByUserId       String?
  recommendedAt             DateTime?
  recommendationNote        String?
  verifiedByUserId      String?
  verifiedAt            DateTime?
  verificationNote      String?
  rejectionReason       String?
  verificationLog           Json?      // [{level, userId, userName, action, note, at}]
  reportingDate         DateTime           @default(now())
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kpiDefinition         KpiDefinition      @relation(fields: [kpiDefinitionId], references: [id], onDelete: Restrict)
  targetAllocation      TargetAllocation?  @relation(fields: [targetAllocationId], references: [id], onDelete: SetNull)
  contributors          AchievementContributor[]
  stageProgress         KpiStageProgress[]
  submissionTrail       SubmissionTrail[]
  contributorRewards    ContributorReward[]

  @@index([tenantId, periodId])
  @@index([targetAllocationId])
  @@index([reportedByUserId, periodId])
  @@index([oboReportedForUserId, periodId])
  @@index([tenantId, state])
}

model AchievementContributor {
  id                  String                   @id @default(cuid())
  achievementId       String
  type                ContributorType          @default(INTERNAL)
  userId              String?
  externalName        String?
  externalAffiliation String?
  externalScope       ExternalContributorScope?
  externalData        Json?
  contributorRoleId   String
  creditPercent       Float
  isExcludedFromReward Boolean                 @default(false)
  selectorTags        String[]                 @default([])
  note                String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  achievement         Achievement              @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user                User?                    @relation("AchievementContributorUser", fields: [userId], references: [id], onDelete: SetNull)
  contributorRole     ContributorRole          @relation(fields: [contributorRoleId], references: [id], onDelete: Restrict)
  contributorRewards  ContributorReward[]

  @@unique([achievementId, userId])
  @@index([achievementId])
  @@index([userId])
  @@index([contributorRoleId])
}

model KpiTargetUnit {
  id              String        @id @default(cuid())
  kpiDefinitionId String
  unitId          String
  targetShare     Float?
  notes           String?
  createdAt       DateTime      @default(now())
  kpiDefinition   KpiDefinition @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)
  unit            OrgUnit       @relation("KpiTargetUnits", fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([kpiDefinitionId, unitId])
  @@index([unitId])
}

model KpiStageDefinition {
  id                   String         @id @default(cuid())
  kpiDefinitionId      String
  stageOrder           Int
  title                String
  description          String?
  isMandatory          Boolean        @default(true)
  weight               Float          @default(0)
  evidenceRequired     Boolean        @default(false)
  evidenceTypes        EvidenceType[] @default([])
  evidenceInstructions String?
  deadline             DateTime?
  gracePeriodDays          Int      @default(0)
  latePenaltyEnabled       Boolean  @default(false)
  latePenaltyPercentPerDay Float    @default(0)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  kpiDefinition        KpiDefinition  @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)
  stageProgress        KpiStageProgress[]
  rewardComponents     KpiRewardComponent[]

  @@unique([kpiDefinitionId, stageOrder])
  @@index([kpiDefinitionId])
}

model KpiStageProgress {
  id                  String             @id @default(cuid())
  targetAllocationId  String
  stageDefinitionId   String
  achievementId       String?
  isCompleted         Boolean            @default(false)
  completedByUserId   String?
  completedAt         DateTime?
  evidenceNote        String?
  notes               String?
  evidenceFiles       Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  targetAllocation    TargetAllocation   @relation(fields: [targetAllocationId], references: [id], onDelete: Cascade)
  stageDefinition     KpiStageDefinition @relation(fields: [stageDefinitionId], references: [id], onDelete: Cascade)
  achievement         Achievement?       @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([targetAllocationId, stageDefinitionId, achievementId])
  @@index([targetAllocationId])
  @@index([achievementId])
}

model SubmissionTrail {
  id            String      @id @default(cuid())
  achievementId String
  action        String
  actorUserId   String
  actorName     String
  actorRole     String
  actorUnitName String?
  note          String?
  scoreAtAction Float?
  metadata      Json?
  createdAt     DateTime    @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@index([achievementId, createdAt])
}

model KpiRewardTier {
  id                String                 @id @default(cuid())
  kpiDefinitionId   String
  tierSetKey        String                 @default("PRIMARY")
  code              String
  name              String
  description       String?
  priority          Int                    @default(0)
  matchMode         KpiRewardTierMatchMode @default(HIGHEST_MATCH)
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  isActive          Boolean                @default(true)
  metadata          Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  kpiDefinition     KpiDefinition          @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)
  rules             KpiRewardRule[]
  rewardComponents  KpiRewardComponent[]
  contributorRewards ContributorReward[]

  @@unique([kpiDefinitionId, tierSetKey, code, effectiveFrom])
  @@index([kpiDefinitionId, tierSetKey, isActive])
  @@index([effectiveFrom, effectiveTo])
}

model KpiRewardRule {
  id              String        @id @default(cuid())
  rewardTierId    String
  source          String
  operator        String
  fieldKey        String?
  systemMetricKey String?
  value           Json?
  sortOrder       Int           @default(0)
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  rewardTier      KpiRewardTier @relation(fields: [rewardTierId], references: [id], onDelete: Cascade)

  @@index([rewardTierId, sortOrder])
}

model KpiRewardComponent {
  id                     String                           @id @default(cuid())
  kpiDefinitionId        String
  rewardTierId           String?
  stageDefinitionId      String?
  parentComponentId      String?
  benefitTypeId          String
  code                   String
  name                   String
  description            String?
  trigger                KpiRewardTrigger                @default(FINAL_VERIFY)
  amountMode             KpiRewardAmountMode
  amountValue            Float?
  amountFieldKey         String?
  distributionMode       KpiRewardDistributionMode       @default(DIRECT_OWNER)
  singleEligibleHandling KpiRewardSingleEligibleHandling @default(FULL_TO_SINGLE)
  emptyShareHandling     KpiRewardEmptyShareHandling     @default(ROLLOVER_TO_MATCHED)
  isActive               Boolean                         @default(true)
  sortOrder              Int                             @default(0)
  metadata               Json?
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  kpiDefinition          KpiDefinition                   @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)
  rewardTier             KpiRewardTier?                  @relation(fields: [rewardTierId], references: [id], onDelete: SetNull)
  stageDefinition        KpiStageDefinition?             @relation(fields: [stageDefinitionId], references: [id], onDelete: SetNull)
  parentComponent        KpiRewardComponent?             @relation("KpiRewardComponentParent", fields: [parentComponentId], references: [id], onDelete: SetNull)
  childComponents        KpiRewardComponent[]            @relation("KpiRewardComponentParent")
  benefitType            BenefitType                     @relation(fields: [benefitTypeId], references: [id], onDelete: Restrict)
  distributions          KpiRewardDistribution[]
  contributorRewards     ContributorReward[]

  @@unique([kpiDefinitionId, code])
  @@index([kpiDefinitionId, rewardTierId, isActive])
  @@index([stageDefinitionId])
}

model KpiRewardDistribution {
  id                String             @id @default(cuid())
  rewardComponentId String
  contributorRoleId String?
  selectorType      String
  selectorTag       String?
  sharePercent      Float?
  fixedAmount       Float?
  splitMode         String?
  sortOrder         Int                @default(0)
  metadata          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  rewardComponent   KpiRewardComponent @relation(fields: [rewardComponentId], references: [id], onDelete: Cascade)
  contributorRole   ContributorRole?   @relation(fields: [contributorRoleId], references: [id], onDelete: SetNull)

  @@index([rewardComponentId, sortOrder])
  @@index([contributorRoleId])
}

model ContributorReward {
  id                      String                  @id @default(cuid())
  tenantId                String
  periodId                String
  kpiDefinitionId         String
  achievementId           String
  achievementContributorId String?
  contributorUserId       String?
  benefitTypeId           String
  rewardTierId            String?
  rewardComponentId       String
  recurrenceKey           String?
  state                   ContributorRewardState @default(DRAFT)
  statusRemark            String?
  releasedAt              DateTime?
  releasedById            String?
  releaseReference        String?
  revokedAt               DateTime?
  revokedById             String?
  revocationReason        String?
  supersedesRewardId      String?
  replacedByRewardId      String?
  rewardOwnerUnitId       String?
  rewardOwnerUnitName     String?
  rewardOwnerUnitPath     String?
  rewardOwnerUnitTypeKey  String?
  reporterUnitId          String?
  reporterUnitName        String?
  reporterUnitPath        String?
  reporterUnitTypeKey     String?
  baseAmount              Float
  finalAmount             Float
  roundingAdjustment      Float                  @default(0)
  explanation             Json?
  idempotencyKey          String                 @unique
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  tenant                  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kpiDefinition           KpiDefinition          @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)
  achievement             Achievement            @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  achievementContributor  AchievementContributor? @relation(fields: [achievementContributorId], references: [id], onDelete: SetNull)
  contributorUser         User?                  @relation("ContributorRewardUser", fields: [contributorUserId], references: [id], onDelete: SetNull)
  benefitType             BenefitType            @relation(fields: [benefitTypeId], references: [id], onDelete: Restrict)
  rewardTier              KpiRewardTier?         @relation(fields: [rewardTierId], references: [id], onDelete: SetNull)
  rewardComponent         KpiRewardComponent     @relation(fields: [rewardComponentId], references: [id], onDelete: Restrict)
  events                  ContributorRewardEvent[]

  @@index([tenantId, periodId, kpiDefinitionId])
  @@index([achievementId])
  @@index([achievementContributorId])
  @@index([contributorUserId])
  @@index([rewardComponentId])
  @@index([tenantId, state, periodId])
  @@index([tenantId, rewardOwnerUnitId, periodId])
  @@index([tenantId, reporterUnitId, periodId])
  @@index([tenantId, releasedAt])
}

model ContributorRewardEvent {
  id          String                  @id @default(cuid())
  rewardId    String
  tenantId    String
  actorUserId String?
  actorRole   Role?
  action      String
  fromState   ContributorRewardState?
  toState     ContributorRewardState?
  note        String?
  metadata    Json?
  createdAt   DateTime                @default(now())
  reward      ContributorReward       @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUser   User?                   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([rewardId, createdAt])
  @@index([tenantId, createdAt])
  @@index([actorUserId])
}

model ReviewCycle {
  id             String           @id @default(cuid())
  periodId       String
  /// Enforced by SQL migration: cycleNumber > 0
  cycleNumber    Int
  label          String
  startDate      DateTime
  endDate        DateTime
  reviewDeadline DateTime?
  isCurrent      Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  period         AssessmentPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, cycleNumber])
  @@index([periodId, isCurrent])
}

model Notification {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String   // recipient
  type        String   // "KPI_ALLOCATED", "ACHIEVEMENT_VERIFIED", etc.
  eventKey    String?
  title       String
  message     String
  entityType  String?  // "Achievement", "TargetAllocation"
  entityId    String?
  linkUrl     String?  // deep link to the relevant page
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([tenantId, userId])
  @@unique([tenantId, userId, eventKey])
}

// ── Module 3: Personnel Lifecycle ────────────────────────────────────────────

model TenantPersonnelPolicy {
  id                            String   @id @default(cuid())
  tenantId                      String   @unique
  defaultNoticePeriodDays       Int      @default(30)
  allowResignationWithdrawal    Boolean  @default(true)
  withdrawalWindowDays          Int      @default(7)
  requireTransferApproval       Boolean  @default(true)
  requireLeaveApproval          Boolean  @default(true)
  allowMultiplePrimaryUnits     Boolean  @default(false)
  maxSecondaryUnits             Int      @default(5)
  autoDeactivateOnExit          Boolean  @default(true)
  requireHeadCoverageBeforeExit Boolean  @default(false)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
  tenant                        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model LeaveTypeDefinition {
  id               String        @id @default(cuid())
  tenantId         String
  typeKey          String
  displayLabel     String
  description      String?
  maxDaysPerYear   Int?
  requiresApproval Boolean       @default(true)
  requiresActing   Boolean       @default(false)
  isPaid           Boolean       @default(true)
  isActive         Boolean       @default(true)
  sortOrder        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaveRecords     LeaveRecord[]

  @@unique([tenantId, typeKey])
  @@index([tenantId, isActive])
}

model LeaveRecord {
  id                String              @id @default(cuid())
  tenantId          String
  membershipId      String
  leaveTypeId       String
  startDate         DateTime
  expectedEndDate   DateTime
  actualEndDate     DateTime?
  reason            String?
  status            LeaveStatus         @default(SCHEDULED)
  approvedByUserId  String?
  createdByUserId   String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership        Membership          @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  leaveType         LeaveTypeDefinition @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  actingAssignments ActingAssignment[]  @relation("LeaveActing")

  @@index([tenantId, status])
  @@index([membershipId, status])
  @@index([tenantId, startDate, expectedEndDate])
}

model ActingAssignment {
  id                   String              @id @default(cuid())
  tenantId             String
  leaveRecordId        String?
  transferRecordId     String?
  versionId            String
  unitId               String
  actingMembershipId   String
  originalMembershipId String
  roleAssignmentId     String?
  startDate            DateTime
  endDate              DateTime?
  isActive             Boolean             @default(true)
  createdByUserId      String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaveRecord          LeaveRecord?        @relation("LeaveActing", fields: [leaveRecordId], references: [id], onDelete: SetNull)
  transferRecord       TransferRecord?     @relation("TransferActing", fields: [transferRecordId], references: [id], onDelete: SetNull)
  version              OrgStructureVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  unit                 OrgUnit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  actingMembership     Membership          @relation("ActingUser", fields: [actingMembershipId], references: [id], onDelete: Cascade)
  originalMembership   Membership          @relation("OriginalUser", fields: [originalMembershipId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@index([leaveRecordId])
  @@index([transferRecordId])
  @@index([actingMembershipId, isActive])
}

model TransferRecord {
  id                   String             @id @default(cuid())
  tenantId             String
  membershipId         String
  sourceUnitId         String
  targetUnitId         String
  effectiveDate        DateTime
  status               TransferStatus     @default(PROPOSED)
  reason               String?
  newRoleDefinitionIds String[]
  initiatedByUserId    String?
  approvedByUserId     String?
  completedAt          DateTime?
  kpiTransferPolicy    TransferKpiPolicy?
  kpiTransferDetails   Json?
  completionNotes      String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership           Membership         @relation("TransferSourceMember", fields: [membershipId], references: [id], onDelete: Cascade)
  sourceUnit           OrgUnit            @relation("TransferSource", fields: [sourceUnitId], references: [id], onDelete: Restrict)
  targetUnit           OrgUnit            @relation("TransferTarget", fields: [targetUnitId], references: [id], onDelete: Restrict)
  actingAssignments    ActingAssignment[] @relation("TransferActing")
  targetActions        TransferTargetAction[]
  statusEvents         TransferStatusEvent[]

  @@index([tenantId, status])
  @@index([membershipId, status])
}

model TransferTargetAction {
  id                 String                   @id @default(cuid())
  transferRecordId   String
  targetAllocationId String
  action             TransferTargetActionType
  previousUnitId     String?
  newUnitId          String?
  notes              String?
  createdAt          DateTime                 @default(now())
  transferRecord     TransferRecord           @relation(fields: [transferRecordId], references: [id], onDelete: Cascade)
  targetAllocation   TargetAllocation         @relation(fields: [targetAllocationId], references: [id], onDelete: Cascade)

  @@index([transferRecordId])
  @@index([targetAllocationId])
}

model TransferStatusEvent {
  id               String                  @id @default(cuid())
  transferRecordId String
  eventType        TransferStatusEventType
  actorUserId      String?
  note             String?
  metadata         Json?
  createdAt        DateTime                @default(now())
  transferRecord   TransferRecord          @relation(fields: [transferRecordId], references: [id], onDelete: Cascade)

  @@index([transferRecordId, createdAt])
}

model ResignationRecord {
  id                String            @id @default(cuid())
  tenantId          String
  membershipId      String
  resignationDate   DateTime
  noticeEndDate     DateTime
  actualExitDate    DateTime?
  reason            String?
  status            ResignationStatus @default(SUBMITTED)
  handoverNotes     String?
  processedByUserId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership        Membership        @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([membershipId, status])
}

model PersonnelAction {
  id            String              @id @default(cuid())
  tenantId      String
  membershipId  String
  actionType    PersonnelActionType
  effectiveDate DateTime
  metadata      Json?
  reason        String?
  actorUserId   String
  createdAt     DateTime            @default(now())
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership    Membership          @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([tenantId, membershipId, createdAt])
  @@index([tenantId, actionType, effectiveDate])
}
