  kpiDefinitions  KpiDefinition[]

  @@index([tenantId, periodId])
  @@index([tenantId, state])
}

model KpiDefinition {
  id                                     String                    @id @default(cuid())
  kraDefinitionId                        String
  title                                  String
  description                            String?
  // ── Measurement ──
  measurementType                        KpiMeasurementType        @default(NUMERIC)
  unitLabel                              String? // "count", "%", "INR", "days"
  weightage                              Int                       @default(0) // must sum to parent KRA's weightage
  defaultTarget                          Float?
  measurementConfig                      Json? // Zod-validated per type
  // ── Scoring ──
  scoringMethod                          ScoringMethod             @default(LINEAR)
  scoringDirection                       ScoringDirection          @default(ASCENDING)
  scoringConfig                          Json? // Zod-validated per method
  isPerCapita                            Boolean                   @default(false)
  // ── Allocation ──
  allocationType                         KpiAllocationType         @default(BOTH)
  startingUnitId                         String // originating department
  // ── Achievement Template ──
  achievementTemplateKey                 String? // "PUBLICATION", "PATENT", etc.
  achievementFormConfig                  Json? // [{key, label, type, required, options?, pattern?}]
  // ── R2: Verification Routing ──
  keyUnitId                              String?
  finalUnitId                            String?
  keyReviewerUserId                      String?
  finalReviewerUserId                    String?
  // ── R2: SOP & Evidence ──
  sopDescription                         String?
  sopFiles                               Json?
  evidenceRequired                       Boolean                   @default(true)
  evidenceTypes                          EvidenceType[]
  evidenceInstructions                   String?
  // ── R2: Team KPI ──
  isTeamKpi                              Boolean                   @default(false)
  teamCreditMethod                       TeamCreditMethod          @default(FULL_EACH)
  // ── R2.2: Stages & submission ──
  allowPartialCompletion                 Boolean                   @default(true)
  allowMultipleAchievementsPerAllocation Boolean                   @default(true)
  contributionRoles                      Json?
  participantMode                        KpiParticipantMode        @default(SINGLE_OWNER)
  rewardRecurrencePolicy                 KpiRewardRecurrencePolicy @default(RECURRING)
  policyDateFieldKey                     String?
  // ── State ──
  state                                  KpiDefinitionState        @default(DRAFT)
  sortOrder                              Int                       @default(0)
  guidanceNotes                          String?
  createdAt                              DateTime                  @default(now())
  updatedAt                              DateTime                  @updatedAt

  kraDefinition               KraDefinition                   @relation(fields: [kraDefinitionId], references: [id], onDelete: Cascade)
  startingUnit                OrgUnit                         @relation("KpiStartingUnit", fields: [startingUnitId], references: [id], onDelete: Restrict)
  keyUnit                     OrgUnit?                        @relation("KpiKeyUnit", fields: [keyUnitId], references: [id], onDelete: SetNull)
  finalUnit                   OrgUnit?                        @relation("KpiFinalUnit", fields: [finalUnitId], references: [id], onDelete: SetNull)
  keyReviewerUser             User?                           @relation("KpiKeyReviewer", fields: [keyReviewerUserId], references: [id], onDelete: SetNull)
  finalReviewerUser           User?                           @relation("KpiFinalReviewer", fields: [finalReviewerUserId], references: [id], onDelete: SetNull)
  targetAllocations           TargetAllocation[]
  achievements                Achievement[]
  targetUnits                 KpiTargetUnit[]
  stages                      KpiStageDefinition[]
  applicableRoles             KpiApplicableRole[]
  contributorConfig           KpiContributorConfig?
  rewardTiers                 KpiRewardTier[]
  rewardComponents            KpiRewardComponent[]
  contributorRewards          ContributorReward[]
  accreditationBlockLinks KpiAccreditationBlockLink[]

  @@index([kraDefinitionId])
  @@index([startingUnitId])
  @@index([keyUnitId])
  @@index([finalUnitId])
  @@index([keyReviewerUserId])
  @@index([finalReviewerUserId])
}

