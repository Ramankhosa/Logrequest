  ARCHIVED
}

enum KpiAllocationType {
  DEPARTMENT // stays at dept level, head owns it
  INDIVIDUAL // must be split to individual members
  BOTH // head decides whether to keep or split
}

enum TargetAllocationState {
  ACTIVE // final value entered, target is live
  LOCKED // frozen after deadline, no changes
}

enum AchievementState {
  DRAFT // being filled in
  SUBMITTED // submitted for verification
  RECOMMENDED // dept head has endorsed
  VERIFIED // approved
  REJECTED // sent back with reason (displayed as "Not Approved" in UI)
}

enum AchievementFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  URL
  EMAIL
  SELECT
  MULTI_SELECT
  BOOLEAN
  DECLARATION
  FILE_LINK
}

enum ScoringMethod {
  LINEAR // actual/target * 100
  THRESHOLD // below = 0, above = 100
  SLAB // defined ranges
}

enum ScoringDirection {
  ASCENDING // higher actual = better (publications, revenue)
  DESCENDING // lower actual = better (attrition, defects, costs)
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum GradeValue {
  OUTSTANDING
  VERY_GOOD
  GOOD
  SATISFACTORY
  NEEDS_IMPROVEMENT
  POOR
}

// ── KRA/KPI Enums (Release 2) ──────────────────────────────────────────────

enum KpiFlowStatus {
  CREATED // allocation just created, no work started
  ASSIGNED // target communicated to assignee
  IN_PROGRESS // assignee working on it
  SUBMITTED // assignee submitted achievement for review
  KEY_REVIEW // key department reviewing (optional step)
  KEY_APPROVED // key department endorsed
  KEY_REJECTED // key department sent back (auto-resets to IN_PROGRESS)
  FINAL_REVIEW // final/starting department reviewing (optional step)
  VERIFIED // fully approved
  REJECTED // sent back at any review level
}

enum EvidenceType {
  DOCUMENT // PDF, DOC, DOCX
  URL // web link
  CERTIFICATE // scanned certificate
  SELF_DECLARATION // self-attested
  SYSTEM_GENERATED // auto-captured by system
  NONE // no evidence needed
}

enum TeamCreditMethod {
  FULL_EACH // each contributor gets 100% credit (count-based KPIs)
  EQUAL_SPLIT // credit divided equally among all contributors
  WEIGHTED_SPLIT // credit split per contributor weight (e.g., first author 60%)
  PRIMARY_ONLY // only primary contributor gets credit
}

enum KpiParticipantMode {
  SINGLE_OWNER
  OPTIONAL_TEAM
  REQUIRED_TEAM
}

enum KpiRewardRecurrencePolicy {
  RECURRING
  ONCE_PER_PERIOD
  ONCE_PER_KPI_LIFETIME
  ONCE_PER_UNIQUE_KEY
}

enum KpiRewardTierMatchMode {
  HIGHEST_MATCH
  MANUAL_SELECT
}

enum KpiRewardTrigger {
  FINAL_VERIFY
  MANUAL
  STAGE_COMPLETE
}

enum KpiRewardAmountMode {
  FIXED_VALUE
  FIXED_POOL
  FIXED_PER_PERSON
  PERCENT_OF_FIELD
  PER_UNIT
  PERCENT_OF_SCORE
}

enum KpiRewardDistributionMode {
  DIRECT_OWNER
  ROLE_PERCENT_SPLIT
  FIXED_PER_PERSON
  EQUAL_SPLIT
  CREDIT_PERCENT_SPLIT
  LEAD_ONLY
}

enum KpiRewardSingleEligibleHandling {
  FULL_TO_SINGLE
  KEEP_CONFIGURED_SPLIT
  ERROR
}

enum KpiRewardEmptyShareHandling {
  ROLLOVER_TO_MATCHED
  DROP_UNALLOCATED
  ERROR
}

enum ContributorRewardState {
  DRAFT
  PENDING
  RELEASED
  REVOKED
}

enum PersonnelStatus {
  ONBOARDING
