  kpiDefinitionId   String
  contributorRoleId String
  isDefault         Boolean         @default(false)
  sortOrder         Int             @default(0)
  kpiDefinition     KpiDefinition   @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)
  contributorRole   ContributorRole @relation(fields: [contributorRoleId], references: [id], onDelete: Cascade)

  @@unique([kpiDefinitionId, contributorRoleId])
  @@index([kpiDefinitionId])
}

model ExternalContributorTemplate {
  id          String                 @id @default(cuid())
  tenantId    String
  name        String
  description String?
  fields      Json
  isDefault   Boolean                @default(false)
  isActive    Boolean                @default(true)
  sortOrder   Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kpiConfigs  KpiContributorConfig[]

  @@index([tenantId, isActive])
}

model KpiContributorConfig {
  id                        String                       @id @default(cuid())
  kpiDefinitionId           String                       @unique
  externalContribTemplateId String?
  allowExternalContributors Boolean                      @default(true)
  duplicateCheckFields      Json?
  creditSumMode             String                       @default("MUST_EQUAL_100")
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  kpiDefinition             KpiDefinition                @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)
  externalContribTemplate   ExternalContributorTemplate? @relation(fields: [externalContribTemplateId], references: [id])

  @@index([externalContribTemplateId])
}

model KpiTemplate {
  id             String   @id @default(cuid())
  tenantId       String?
  code           String   @unique
  name           String
  description    String?
  category       String?
  isSystem       Boolean  @default(false)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  builderPayload Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@index([isSystem, isActive])
}

model TargetAllocation {
  id                     String                 @id @default(cuid())
  tenantId               String
  periodId               String
  kpiDefinitionId        String
  assignedToUnitId       String?
  assignedToUserId       String?
  allocatedByUserId      String
  // Target (polymorphic by measurement type)
  targetValue            Float?
  targetDate             DateTime?
  targetMilestone        MilestoneStatus?
  targetGrade            GradeValue?
  targetBoolean          Boolean?
  targetRating           Int?
  // State
  state                  TargetAllocationState  @default(ACTIVE)
  lockedAt               DateTime?
  // ── R2: Flow tracking ──
  flowStatus             KpiFlowStatus          @default(CREATED)
  flowLog                Json?
  // ── R2: Verifier override ──
  verifierOverrideUserId String?
  verifierOverrideNote   String?
  // ── R2: Team weights ──
  teamWeights            Json?
  // Cascade lineage
  parentAllocationId     String?
  notes                  String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  tenant                 Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period                 AssessmentPeriod       @relation(fields: [periodId], references: [id], onDelete: Restrict)
  kpiDefinition          KpiDefinition          @relation(fields: [kpiDefinitionId], references: [id], onDelete: Restrict)
  assignedToUnit         OrgUnit?               @relation("TargetUnit", fields: [assignedToUnitId], references: [id], onDelete: SetNull)
  assignedToUser         User?                  @relation("TargetUser", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  parentAllocation       TargetAllocation?      @relation("CascadeParent", fields: [parentAllocationId], references: [id], onDelete: SetNull)
  childAllocations       TargetAllocation[]     @relation("CascadeParent")
  achievements           Achievement[]
  stageProgress          KpiStageProgress[]
  transferActions        TransferTargetAction[]

  @@index([tenantId, periodId, kpiDefinitionId])
  @@index([assignedToUnitId, periodId])
  @@index([assignedToUserId, periodId])
  @@index([parentAllocationId])
}

model Achievement {
  id                    String                   @id @default(cuid())
  tenantId              String
  periodId              String
  kpiDefinitionId       String
  targetAllocationId    String?
  reportedByUserId      String
  oboReportedForUserId  String?
  // Actuals (polymorphic)
  actualValue           Float?
  actualDate            DateTime?
  actualMilestone       MilestoneStatus?
  actualGrade           GradeValue?
  actualBoolean         Boolean?
  actualRating          Int?
  // Evidence (simple text in R1, file uploads added in R2)
  evidenceDescription   String?
  evidenceLinks         String[] // URLs for now, file uploads in R2
  // ── R2: Evidence files ──
  evidenceFiles         Json?
  // ── R2: Multi-level verification ──
  currentVerifierUserId String?
  currentVerifierUnitId String?
  // ── R2: Team achievement ──
  isTeamAchievement     Boolean                  @default(false)
  // Scoring
  computedScore         Float? // 0-100
  // Dynamic form data (R1.1a)
  achievementFormData   Json? // filled-in custom fields per KPI template
  // ── R2.2: Named instance & stage score ──
  title                 String?
  contributionRole      String?
  creditPercent         Float?
  effectiveScore        Float?
  stageCompletionScore  Float?
  duplicateCheckResult  Json?
  isOBO                 Boolean                  @default(false)
  // 2-level verification (R1.1a)
  state                 AchievementState         @default(DRAFT)
  recommendedByUserId   String?
  recommendedAt         DateTime?
  recommendationNote    String?
  verifiedByUserId      String?
  verifiedAt            DateTime?
  verificationNote      String?
  rejectionReason       String?
  verificationLog       Json? // [{level, userId, userName, action, note, at}]
  reportingDate         DateTime                 @default(now())
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  tenant                Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kpiDefinition         KpiDefinition            @relation(fields: [kpiDefinitionId], references: [id], onDelete: Restrict)
  targetAllocation      TargetAllocation?        @relation(fields: [targetAllocationId], references: [id], onDelete: SetNull)
  contributors          AchievementContributor[]
  stageProgress         KpiStageProgress[]
  submissionTrail       SubmissionTrail[]
  contributorRewards    ContributorReward[]

  @@index([tenantId, periodId])
  @@index([targetAllocationId])
  @@index([reportedByUserId, periodId])
  @@index([oboReportedForUserId, periodId])
  @@index([tenantId, state])
}

model AchievementContributor {
  id                   String                    @id @default(cuid())
  achievementId        String
  type                 ContributorType           @default(INTERNAL)
  userId               String?
  externalName         String?
  externalAffiliation  String?
  externalScope        ExternalContributorScope?
  externalData         Json?
  contributorRoleId    String
  creditPercent        Float
  isExcludedFromReward Boolean                   @default(false)
  selectorTags         String[]                  @default([])
  note                 String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  achievement          Achievement               @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user                 User?                     @relation("AchievementContributorUser", fields: [userId], references: [id], onDelete: SetNull)
  contributorRole      ContributorRole           @relation(fields: [contributorRoleId], references: [id], onDelete: Restrict)
  contributorRewards   ContributorReward[]

  @@unique([achievementId, userId])
  @@index([achievementId])
  @@index([userId])
  @@index([contributorRoleId])
}

model KpiTargetUnit {
  id              String        @id @default(cuid())
  kpiDefinitionId String
  unitId          String
  targetShare     Float?
  notes           String?
  createdAt       DateTime      @default(now())
  kpiDefinition   KpiDefinition @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)
  unit            OrgUnit       @relation("KpiTargetUnits", fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([kpiDefinitionId, unitId])
  @@index([unitId])
}

model KpiStageDefinition {
  id                       String               @id @default(cuid())
  kpiDefinitionId          String
  stageOrder               Int
  title                    String
  description              String?
  isMandatory              Boolean              @default(true)
  weight                   Float                @default(0)
  evidenceRequired         Boolean              @default(false)
  evidenceTypes            EvidenceType[]       @default([])
  evidenceInstructions     String?
  deadline                 DateTime?
  gracePeriodDays          Int                  @default(0)
  latePenaltyEnabled       Boolean              @default(false)
  latePenaltyPercentPerDay Float                @default(0)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  kpiDefinition            KpiDefinition        @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)
  stageProgress            KpiStageProgress[]
  rewardComponents         KpiRewardComponent[]

  @@unique([kpiDefinitionId, stageOrder])
  @@index([kpiDefinitionId])
}

model KpiStageProgress {
  id                 String             @id @default(cuid())
  targetAllocationId String
  stageDefinitionId  String
  achievementId      String?
  isCompleted        Boolean            @default(false)
  completedByUserId  String?
  completedAt        DateTime?
  evidenceNote       String?
  notes              String?
  evidenceFiles      Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  targetAllocation   TargetAllocation   @relation(fields: [targetAllocationId], references: [id], onDelete: Cascade)
  stageDefinition    KpiStageDefinition @relation(fields: [stageDefinitionId], references: [id], onDelete: Cascade)
  achievement        Achievement?       @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([targetAllocationId, stageDefinitionId, achievementId])
  @@index([targetAllocationId])
  @@index([achievementId])
}

model SubmissionTrail {
  id            String      @id @default(cuid())
  achievementId String
  action        String
  actorUserId   String
  actorName     String
  actorRole     String
  actorUnitName String?
  note          String?
  scoreAtAction Float?
  metadata      Json?
  createdAt     DateTime    @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@index([achievementId, createdAt])
}

model KpiRewardTier {
  id                 String                 @id @default(cuid())
  kpiDefinitionId    String
  tierSetKey         String                 @default("PRIMARY")
  code               String
  name               String
  description        String?
  priority           Int                    @default(0)
  matchMode          KpiRewardTierMatchMode @default(HIGHEST_MATCH)
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  isActive           Boolean                @default(true)
  metadata           Json?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  kpiDefinition      KpiDefinition          @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)
  rules              KpiRewardRule[]
  rewardComponents   KpiRewardComponent[]
  contributorRewards ContributorReward[]

  @@unique([kpiDefinitionId, tierSetKey, code, effectiveFrom])
  @@index([kpiDefinitionId, tierSetKey, isActive])
  @@index([effectiveFrom, effectiveTo])
}

model KpiRewardRule {
  id              String        @id @default(cuid())
  rewardTierId    String
  source          String
  operator        String
  fieldKey        String?
  systemMetricKey String?
  value           Json?
  sortOrder       Int           @default(0)
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  rewardTier      KpiRewardTier @relation(fields: [rewardTierId], references: [id], onDelete: Cascade)

  @@index([rewardTierId, sortOrder])
}

model KpiRewardComponent {
  id                     String                          @id @default(cuid())
  kpiDefinitionId        String
  rewardTierId           String?
  stageDefinitionId      String?
  parentComponentId      String?
  benefitTypeId          String
  code                   String
  name                   String
  description            String?
  trigger                KpiRewardTrigger                @default(FINAL_VERIFY)
  amountMode             KpiRewardAmountMode
  amountValue            Float?
  amountFieldKey         String?
  distributionMode       KpiRewardDistributionMode       @default(DIRECT_OWNER)
  singleEligibleHandling KpiRewardSingleEligibleHandling @default(FULL_TO_SINGLE)
  emptyShareHandling     KpiRewardEmptyShareHandling     @default(ROLLOVER_TO_MATCHED)
  isActive               Boolean                         @default(true)
  sortOrder              Int                             @default(0)
  metadata               Json?
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  kpiDefinition          KpiDefinition                   @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)
  rewardTier             KpiRewardTier?                  @relation(fields: [rewardTierId], references: [id], onDelete: SetNull)
  stageDefinition        KpiStageDefinition?             @relation(fields: [stageDefinitionId], references: [id], onDelete: SetNull)
  parentComponent        KpiRewardComponent?             @relation("KpiRewardComponentParent", fields: [parentComponentId], references: [id], onDelete: SetNull)
  childComponents        KpiRewardComponent[]            @relation("KpiRewardComponentParent")
  benefitType            BenefitType                     @relation(fields: [benefitTypeId], references: [id], onDelete: Restrict)
  distributions          KpiRewardDistribution[]
  contributorRewards     ContributorReward[]

  @@unique([kpiDefinitionId, code])
  @@index([kpiDefinitionId, rewardTierId, isActive])
  @@index([stageDefinitionId])
}

model KpiRewardDistribution {
  id                String             @id @default(cuid())
  rewardComponentId String
  contributorRoleId String?
  selectorType      String
  selectorTag       String?
  sharePercent      Float?
  fixedAmount       Float?
  splitMode         String?
  sortOrder         Int                @default(0)
  metadata          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  rewardComponent   KpiRewardComponent @relation(fields: [rewardComponentId], references: [id], onDelete: Cascade)
  contributorRole   ContributorRole?   @relation(fields: [contributorRoleId], references: [id], onDelete: SetNull)

  @@index([rewardComponentId, sortOrder])
  @@index([contributorRoleId])
}

model ContributorReward {
  id                       String                   @id @default(cuid())
  tenantId                 String
  periodId                 String
  kpiDefinitionId          String
  achievementId            String
  achievementContributorId String?
  contributorUserId        String?
  benefitTypeId            String
  rewardTierId             String?
  rewardComponentId        String
  recurrenceKey            String?
  state                    ContributorRewardState   @default(DRAFT)
  statusRemark             String?
  releasedAt               DateTime?
  releasedById             String?
  releaseReference         String?
  revokedAt                DateTime?
  revokedById              String?
  revocationReason         String?
  supersedesRewardId       String?
  replacedByRewardId       String?
  rewardOwnerUnitId        String?
  rewardOwnerUnitName      String?
  rewardOwnerUnitPath      String?
  rewardOwnerUnitTypeKey   String?
  reporterUnitId           String?
  reporterUnitName         String?
  reporterUnitPath         String?
  reporterUnitTypeKey      String?
  baseAmount               Float
  finalAmount              Float
  roundingAdjustment       Float                    @default(0)
  explanation              Json?
  idempotencyKey           String                   @unique
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  tenant                   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kpiDefinition            KpiDefinition            @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)
  achievement              Achievement              @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  achievementContributor   AchievementContributor?  @relation(fields: [achievementContributorId], references: [id], onDelete: SetNull)
  contributorUser          User?                    @relation("ContributorRewardUser", fields: [contributorUserId], references: [id], onDelete: SetNull)
  benefitType              BenefitType              @relation(fields: [benefitTypeId], references: [id], onDelete: Restrict)
  rewardTier               KpiRewardTier?           @relation(fields: [rewardTierId], references: [id], onDelete: SetNull)
  rewardComponent          KpiRewardComponent       @relation(fields: [rewardComponentId], references: [id], onDelete: Restrict)
  events                   ContributorRewardEvent[]

  @@index([tenantId, periodId, kpiDefinitionId])
  @@index([achievementId])
  @@index([achievementContributorId])
  @@index([contributorUserId])
  @@index([rewardComponentId])
  @@index([tenantId, state, periodId])
  @@index([tenantId, rewardOwnerUnitId, periodId])
  @@index([tenantId, reporterUnitId, periodId])
  @@index([tenantId, releasedAt])
}

model ContributorRewardEvent {
  id          String                  @id @default(cuid())
  rewardId    String
  tenantId    String
  actorUserId String?
  actorRole   Role?
  action      String
  fromState   ContributorRewardState?
  toState     ContributorRewardState?
  note        String?
  metadata    Json?
  createdAt   DateTime                @default(now())
  reward      ContributorReward       @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUser   User?                   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([rewardId, createdAt])
  @@index([tenantId, createdAt])
  @@index([actorUserId])
}

model ReviewCycle {
  id             String           @id @default(cuid())
  periodId       String
  /// Enforced by SQL migration: cycleNumber > 0
  cycleNumber    Int
  label          String
  startDate      DateTime
  endDate        DateTime
  reviewDeadline DateTime?
  isCurrent      Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  period         AssessmentPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, cycleNumber])
  @@index([periodId, isCurrent])
}

model Notification {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String // recipient
  type       String // "KPI_ALLOCATED", "ACHIEVEMENT_VERIFIED", etc.
  eventKey   String?
  title      String
  message    String
  entityType String? // "Achievement", "TargetAllocation"
  entityId   String?
  linkUrl    String? // deep link to the relevant page
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, eventKey])
  @@index([userId, isRead, createdAt])
  @@index([tenantId, userId])
}

// ── Module 3: Personnel Lifecycle ────────────────────────────────────────────

model TenantPersonnelPolicy {
  id                            String   @id @default(cuid())
  tenantId                      String   @unique
  defaultNoticePeriodDays       Int      @default(30)
  allowResignationWithdrawal    Boolean  @default(true)
  withdrawalWindowDays          Int      @default(7)
  requireTransferApproval       Boolean  @default(true)
  requireLeaveApproval          Boolean  @default(true)
  allowMultiplePrimaryUnits     Boolean  @default(false)
  maxSecondaryUnits             Int      @default(5)
  autoDeactivateOnExit          Boolean  @default(true)
  requireHeadCoverageBeforeExit Boolean  @default(false)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
  tenant                        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model LeaveTypeDefinition {
  id               String        @id @default(cuid())
  tenantId         String
  typeKey          String
  displayLabel     String
  description      String?
  maxDaysPerYear   Int?
  requiresApproval Boolean       @default(true)
  requiresActing   Boolean       @default(false)
  isPaid           Boolean       @default(true)
  isActive         Boolean       @default(true)
  sortOrder        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaveRecords     LeaveRecord[]

  @@unique([tenantId, typeKey])
  @@index([tenantId, isActive])
}

model LeaveRecord {
  id                String              @id @default(cuid())
  tenantId          String
  membershipId      String
  leaveTypeId       String
  startDate         DateTime
  expectedEndDate   DateTime
  actualEndDate     DateTime?
  reason            String?
  status            LeaveStatus         @default(SCHEDULED)
  approvedByUserId  String?
  createdByUserId   String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership        Membership          @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  leaveType         LeaveTypeDefinition @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  actingAssignments ActingAssignment[]  @relation("LeaveActing")

  @@index([tenantId, status])
  @@index([membershipId, status])
  @@index([tenantId, startDate, expectedEndDate])
}

model ActingAssignment {
  id                   String              @id @default(cuid())
  tenantId             String
  leaveRecordId        String?
  transferRecordId     String?
  versionId            String
  unitId               String
  actingMembershipId   String
  originalMembershipId String
  roleAssignmentId     String?
  startDate            DateTime
  endDate              DateTime?
  isActive             Boolean             @default(true)
  createdByUserId      String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaveRecord          LeaveRecord?        @relation("LeaveActing", fields: [leaveRecordId], references: [id], onDelete: SetNull)
  transferRecord       TransferRecord?     @relation("TransferActing", fields: [transferRecordId], references: [id], onDelete: SetNull)
  version              OrgStructureVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  unit                 OrgUnit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  actingMembership     Membership          @relation("ActingUser", fields: [actingMembershipId], references: [id], onDelete: Cascade)
  originalMembership   Membership          @relation("OriginalUser", fields: [originalMembershipId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@index([leaveRecordId])
  @@index([transferRecordId])
  @@index([actingMembershipId, isActive])
}

model TransferRecord {
  id                   String                 @id @default(cuid())
  tenantId             String
  membershipId         String
  sourceUnitId         String
  targetUnitId         String
  effectiveDate        DateTime
  status               TransferStatus         @default(PROPOSED)
  reason               String?
  newRoleDefinitionIds String[]
  initiatedByUserId    String?
  approvedByUserId     String?
  completedAt          DateTime?
  kpiTransferPolicy    TransferKpiPolicy?
  kpiTransferDetails   Json?
  completionNotes      String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership           Membership             @relation("TransferSourceMember", fields: [membershipId], references: [id], onDelete: Cascade)
  sourceUnit           OrgUnit                @relation("TransferSource", fields: [sourceUnitId], references: [id], onDelete: Restrict)
  targetUnit           OrgUnit                @relation("TransferTarget", fields: [targetUnitId], references: [id], onDelete: Restrict)
  actingAssignments    ActingAssignment[]     @relation("TransferActing")
  targetActions        TransferTargetAction[]
  statusEvents         TransferStatusEvent[]

  @@index([tenantId, status])
  @@index([membershipId, status])
}

model TransferTargetAction {
  id                 String                   @id @default(cuid())
  transferRecordId   String
  targetAllocationId String
  action             TransferTargetActionType
  previousUnitId     String?
  newUnitId          String?
  notes              String?
  createdAt          DateTime                 @default(now())
  transferRecord     TransferRecord           @relation(fields: [transferRecordId], references: [id], onDelete: Cascade)
  targetAllocation   TargetAllocation         @relation(fields: [targetAllocationId], references: [id], onDelete: Cascade)

  @@index([transferRecordId])
  @@index([targetAllocationId])
}

model TransferStatusEvent {
  id               String                  @id @default(cuid())
  transferRecordId String
  eventType        TransferStatusEventType
  actorUserId      String?
  note             String?
  metadata         Json?
  createdAt        DateTime                @default(now())
  transferRecord   TransferRecord          @relation(fields: [transferRecordId], references: [id], onDelete: Cascade)

  @@index([transferRecordId, createdAt])
}

model ResignationRecord {
  id                String            @id @default(cuid())
  tenantId          String
  membershipId      String
  resignationDate   DateTime
  noticeEndDate     DateTime
  actualExitDate    DateTime?
  reason            String?
  status            ResignationStatus @default(SUBMITTED)
  handoverNotes     String?
  processedByUserId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership        Membership        @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([membershipId, status])
}

model PersonnelAction {
  id            String              @id @default(cuid())
  tenantId      String
  membershipId  String
  actionType    PersonnelActionType
  effectiveDate DateTime
  metadata      Json?
  reason        String?
  actorUserId   String
  createdAt     DateTime            @default(now())
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership    Membership          @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([tenantId, membershipId, createdAt])
  @@index([tenantId, actionType, effectiveDate])
}

